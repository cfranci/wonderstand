<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cf.wonderstand-caffeinate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>while true; do
  if /usr/local/bin/icalBuddy -nrd -nc -ea -b "" -po title eventsToday 2&gt;/dev/null | grep -q "Meeting"; then
    /usr/bin/caffeinate -i -t 60
  fi
  sleep 30
done</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/cf/Projects/wonderstand/output/caffeinate.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cf/Projects/wonderstand/output/caffeinate.err</string>
</dict>
</plist>
